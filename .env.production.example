# ─────────────────────────────────────────────────────────────────────────────
# Variables de la pile « wetchah-erp » (docker-compose.prod.yml).
# Dans Portainer : Stacks → Add stack → Environment variables (mode « Advanced »
# pour coller ce fichier d'un bloc). En ligne de commande : copier en .env.
# ─────────────────────────────────────────────────────────────────────────────

# OBLIGATOIRE — docker run --rm wetchah-erp:latest php artisan key:generate --show
APP_KEY=

# Adresse sous laquelle les utilisateurs ouvrent la console.
APP_URL=http://192.0.2.10:8080
ERP_PORT=8080

# Nom DNS ou IP du serveur, tel que vu par un navigateur : sert aux liens
# « Ouvrir » vers les établissements, à leur APP_URL et au mode assistance.
TENANTS_PUBLIC_HOST=192.0.2.10

# Chemin ABSOLU sur le serveur (identique dans le conteneur).
TENANTS_BASE_PATH=/var/wetchah/tenants

TZ=Africa/Douala

# Derrière un reverse proxy HTTPS : « * » (ou les adresses du proxy) et cookie sécurisé.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false

# Clés Web Push de l'éditeur : npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:support@exemple.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Messagerie (resend ou log)
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@exemple.com

# Facultatif — anciens secrets communs, inutiles pour une installation neuve.
REPORTING_SECRET=
ASSISTANCE_SECRET=

# Facultatif — images des établissements (défauts : GHCR publics).
# REGISTRY_IMAGE=ghcr.io/adrien-stage/villa_b
# REGISTRY_IMAGE_WEB=ghcr.io/clyde237/site_villab
